# 128  ## O(nlogn) solution
class Solution:
    def longestConsecutive(self, nums: List[int]) -> int:
        if not nums:
            return 0
        z=len(nums)
        if z== 1:
            return 1
        nums.sort()
        temp = nums[0]
        c=1
        maxx=1
        for i in range(1,z):
            if nums[i] == nums[i-1]:
                continue
            elif nums[i] == (nums[i-1] + 1):
                c+=1
            else:
                c = 1
            if c > maxx:
                maxx = c
        return maxx

### 2501  ### O(n) runtime
class Solution:
    def longestSquareStreak(self, nums: List[int]) -> int:
        maxx=0
        c=0
        t=0
        nums = set(nums)
        for n in nums:
            t=n*n
            if t in nums:
                c = 2
                if c>maxx:
                    maxx = c
                while t*t in nums:
                    t=t*t
                    c+=1
                    if c > maxx:
                        maxx = c      
        if maxx == 0:
            return -1
        return maxx
